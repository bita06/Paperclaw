# Environment Configuration for PaperClaw backend

# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
PROJECT_NAME=PaperClaw
PROJECT_VERSION=0.1.0
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://paperclaw_user:password@127.0.0.1:5432/paperclaw_db
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Authentication
SECRET_KEY=replace_with_a_secure_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
BOOTSTRAP_DEVELOPER_ADMIN_EMAIL=teacher_or_admin@example.com
BOOTSTRAP_DEVELOPER_ADMIN_PASSWORD=replace_with_local_password
BOOTSTRAP_DEVELOPER_ADMIN_NAME=PaperClaw Developer Admin
BOOTSTRAP_DEVELOPER_ADMIN_DEPARTMENT=PaperClaw

# LLM - MiniMax (required for structured answers and parse enhancement)
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_BASE_URL=https://api.minimaxi.com/v1/text/chatcompletion_v2
MINIMAX_MODEL=MiniMax-M2.5
MINIMAX_TIMEOUT_SECONDS=60
ENABLE_LLM_FEATURES=true

# Web of Science (optional, used when WoS evidence is enabled)
WOS_API_KEY=your_wos_api_key
WOS_BASE_URL=https://api.clarivate.com/apis/wos-starter/v1
WOS_TIMEOUT_SECONDS=30

# Legacy / optional providers
OPENAI_API_KEY=
LLM_MODEL=gpt-3.5-turbo
LLM_EMBEDDING_MODEL=text-embedding-ada-002
PINECONE_API_KEY=
PINECONE_INDEX_NAME=paperclaw-index
PINECONE_ENVIRONMENT=us-west1-gcp
EMBEDDING_DIMENSION=1536
ENABLE_VECTOR_SEARCH=true
ENABLE_PDF_PROCESSING=true

# Redis / cache (optional for local MVP)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# Frontend integration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000"]
